# Firebase web app configuration (Firebase Console -> Project settings -> General).
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK credentials. Create a service account in Project settings ->
# Service accounts, then paste the downloaded JSON on one line. Keep this secret.
FIREBASE_SERVICE_ACCOUNT=

# Optional Firestore collection names (created automatically when sample data is seeded).
FIREBASE_CATEGORIES_COLLECTION_ID=categories
FIREBASE_POSTS_COLLECTION_ID=posts

PORT=3000
