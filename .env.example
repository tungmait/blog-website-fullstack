# Appwrite configuration (Appwrite Education / Cloud: https://cloud.appwrite.io)
# 1. Create a project -> Project ID
# 2. Settings -> API keys -> create key with databases/collections/attributes/documents read+write scopes
# 3. Databases -> create a database -> Database ID
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=your_database_id
# Collections are created automatically on first run if they do not exist
APPWRITE_CATEGORIES_COLLECTION_ID=categories
APPWRITE_POSTS_COLLECTION_ID=posts

PORT=3000
