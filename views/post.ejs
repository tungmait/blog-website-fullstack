<%- include('partials/header') %>

<div class="content-layout">
  <article class="article-card">
    <span class="badge"><%= post.category_name || 'Bài viết' %></span>
    <h1><%= post.title %></h1>
    <div class="meta-row">
      <span><%= new Date(post.created_at).toLocaleDateString('vi-VN') %></span>
      <span>👤 <%= post.author %></span>
    </div>

    <div class="article-body">
      <%- post.content.replace(/\n/g, '<br>') %>
    </div>
  </article>

  <aside class="sidebar-card">
    <h3>Bài viết liên quan</h3>
    <% if (relatedPosts && relatedPosts.length) { %>
      <div class="side-list">
        <% relatedPosts.forEach(item => { %>
          <div class="side-item">
            <small><%= item.category_name || 'Bài viết' %></small>
            <h4><a href="/post/<%= item.id %>"><%= item.title %></a></h4>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>Chưa có bài viết liên quan.</p>
    <% } %>
  </aside>
</div>

<%- include('partials/footer') %>
